{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/production.schema.json",
  "title": "GT500 Companion — production",
  "description": "Array of production records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "scope",
      "value",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "anyOf": [
          {
            "type": [
              "string",
              "number"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "context": {
        "type": "string",
        "minLength": 1
      },
      "conflicts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/conflict"
        },
        "minItems": 1
      },
      "note": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
