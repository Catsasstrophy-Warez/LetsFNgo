{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/dynoBaselines.schema.json",
  "title": "GT500 Companion — dynoBaselines",
  "description": "Array of dynoBaselines records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "year",
      "whp",
      "wtq",
      "dyno",
      "correction",
      "fuel",
      "date",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "year": {
        "anyOf": [
          {
            "enum": [
              2020,
              2021,
              2022
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "whp": {
        "type": "number"
      },
      "wtq": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "dyno": {
        "enum": [
          "dynojet",
          "mustang",
          "hub",
          "other"
        ]
      },
      "correction": {
        "enum": [
          "sae",
          "std",
          "uncorrected",
          "unknown"
        ]
      },
      "fuel": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "date": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          {
            "type": "null"
          }
        ]
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "context": {
        "type": "string",
        "minLength": 1
      },
      "note": {
        "type": "string",
        "minLength": 1
      },
      "originalUrl": {
        "$ref": "#/$defs/source"
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    }
  }
}
