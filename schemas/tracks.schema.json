{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/tracks.schema.json",
  "title": "GT500 Companion — tracks",
  "description": "Array of tracks records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "kind",
      "configuration",
      "city",
      "state",
      "facility",
      "startFinish",
      "sectors",
      "lengthMi",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "road course",
          "drag strip",
          "oval + road course",
          "road course + drag strip",
          "oval + road course + drag strip"
        ]
      },
      "configuration": {
        "type": "string",
        "minLength": 1
      },
      "city": {
        "type": "string",
        "minLength": 1
      },
      "state": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "facility": {
        "anyOf": [
          {
            "$ref": "#/$defs/geoPoint"
          },
          {
            "type": "null"
          }
        ]
      },
      "startFinish": {
        "anyOf": [
          {
            "$ref": "#/$defs/geoLine"
          },
          {
            "type": "null"
          }
        ]
      },
      "sectors": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/geoLine"
        }
      },
      "lengthMi": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "direction": {
        "enum": [
          1,
          -1
        ]
      },
      "noiseLimit": {
        "type": "object",
        "required": [
          "value",
          "source",
          "confidence"
        ],
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/numberValue"
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "originalUrl": {
            "$ref": "#/$defs/source"
          }
        },
        "additionalProperties": false
      },
      "note": {
        "type": "string",
        "minLength": 1
      },
      "originalUrl": {
        "$ref": "#/$defs/source"
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "geoPoint": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "geoLine": {
      "type": "object",
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/geoPoint"
        },
        "b": {
          "$ref": "#/$defs/geoPoint"
        }
      },
      "additionalProperties": false
    }
  }
}
