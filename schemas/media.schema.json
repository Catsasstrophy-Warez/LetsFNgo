{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/media.schema.json",
  "title": "GT500 Companion — media",
  "description": "Array of media records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "youtubeId",
      "title",
      "credit",
      "category",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "youtubeId": {
        "type": "string",
        "pattern": "^[\\w-]{11}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "credit": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "Official",
          "Review",
          "Comparison",
          "Track",
          "Drag / Dyno",
          "Onboard",
          "Stock sound",
          "Aftermarket sound"
        ]
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "modified": {
        "type": "boolean"
      },
      "note": {
        "type": "string",
        "minLength": 1
      },
      "originalUrl": {
        "$ref": "#/$defs/source"
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "geoPoint": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "geoLine": {
      "type": "object",
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/geoPoint"
        },
        "b": {
          "$ref": "#/$defs/geoPoint"
        }
      },
      "additionalProperties": false
    }
  }
}
