{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/modStages.schema.json",
  "title": "GT500 Companion — modStages",
  "description": "Array of modStages records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "stage",
      "parts",
      "result",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "stage": {
        "type": "string",
        "minLength": 1
      },
      "parts": {
        "type": "string",
        "minLength": 1
      },
      "result": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "status": {
        "const": "excluded"
      },
      "cost": {
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "gain": {
        "type": "object",
        "required": [
          "whp",
          "basis"
        ],
        "properties": {
          "whp": {
            "type": "number"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "note": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
