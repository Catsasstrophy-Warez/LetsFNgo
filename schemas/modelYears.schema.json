{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Catsasstrophy-Warez/LetsFNgo/schemas/modelYears.schema.json",
  "title": "GT500 Companion — modelYears",
  "description": "Array of modelYears records (src/data). Every record cites an https source and a confidence level; unknowns are null with a note.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "year",
      "name",
      "builder",
      "summary",
      "changes",
      "source",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "year": {
        "anyOf": [
          {
            "enum": [
              2020,
              2021,
              2022
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "builder": {
        "enum": [
          "Ford",
          "Shelby American"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "changes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "confidence": {
        "$ref": "#/$defs/confidence"
      },
      "note": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "reported",
        "unverified"
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
